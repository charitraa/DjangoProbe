# DjangoProbe configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` in your working directory and fill in the values.
# DjangoProbe loads `.env` via python-dotenv at startup.
#
#   cp .env.example .env
#
# At least ONE provider must be configured or DjangoProbe exits.
# NVIDIA NIM is always tried first; the others are fallbacks that only
# initialize when their API key is present.
# ---------------------------------------------------------------------------

# === Provider selection ====================================================
# `auto` (default) or one of: nvidia | anthropic | groq | gemini | together
# Reorders the NON-NVIDIA providers only; NVIDIA always stays first priority.
AI_PREFERRED_PROVIDER=auto

# === NVIDIA NIM (primary provider, OpenAI-compatible) ======================
NVIDIA_API_KEY=
NVIDIA_MODEL=qwen/qwen3.5-122b-a10b
# Any OpenAI-compatible endpoint works here.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# === Anthropic (fallback) ==================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3.5-sonnet
# Leave empty to use the default Anthropic API endpoint.
ANTHROPIC_BASE_URL=

# === Groq (fallback) =======================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# === Google Gemini (fallback) ==============================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === Together AI (fallback) ================================================
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# === Retry behaviour =======================================================
# Number of retries per AI call, and delay (seconds) between retries.
AI_MAX_RETRIES=3
AI_RETRY_DELAY=60
